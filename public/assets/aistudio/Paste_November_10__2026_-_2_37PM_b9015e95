  </footer>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const nav = document.getElementById('main-nav');
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileLinks = document.querySelectorAll('.mobile-link');
      
      // Scroll handling
      function handleScroll() {
        if (window.scrollY > 50) {
          nav.classList.remove('bg-transparent', 'text-brand-black');
          nav.classList.add('bg-brand-black', 'text-brand-white', 'shadow-lg');
        } else {
          // If menu is open, keep navbar visible in contrast mode (don't revert to black text on black bg)
          if (!mobileMenu.classList.contains('translate-x-full')) return;

          nav.classList.remove('bg-brand-black', 'text-brand-white', 'shadow-lg', 'text-brand-acid');
          nav.classList.add('bg-transparent', 'text-brand-black');
        }
      }

      window.addEventListener('scroll', handleScroll);

      // Mobile Menu Logic
      mobileBtn.addEventListener('click', () => {
        const isClosed = mobileMenu.classList.contains('translate-x-full');
        
        if (isClosed) {
          // Open Menu
          mobileMenu.classList.remove('translate-x-full');
          mobileBtn.textContent = 'Close';
          
          // Force navbar text to acid green for visibility against black menu
          nav.classList.remove('text-brand-black', 'text-brand-white');
          nav.classList.add('text-brand-acid'); 
        } else {
          // Close Menu
          mobileMenu.classList.add('translate-x-full');
          mobileBtn.textContent = 'Menu';
          
          nav.classList.remove('text-brand-acid');
          // Revert to correct scroll state
          handleScroll();
        }
      });

      // Close menu when clicking a link
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('translate-x-full');
          mobileBtn.textContent = 'Menu';
          nav.classList.remove('text-brand-acid');
          handleScroll();
        });
      });
    });
  </script>

</body></html>