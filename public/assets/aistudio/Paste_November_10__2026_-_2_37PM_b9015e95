       <!-- Big Name -->
       <div class="border-t border-gray-800 pt-10 relative z-10">
          <h1 class="text-[12vw] leading-none font-black uppercase text-center md:text-left text-stroke tracking-tighter">
            ANANYA SINGH
          </h1>
          <div class="flex flex-col md:flex-row justify-between items-center mt-8 text-xs font-mono text-gray-500 uppercase">
             <p>© 2024 Ananya Singh Portfolio. All rights reserved.</p>
             <p>Designed with Brutalism</p>
